# Copy to .env for local development (`npm run dev`). Never commit .env.
# In production set these in Netlify → Site configuration → Environment variables.

# Browser (public, safe to expose)
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Server only (Netlify Functions) – keep secret
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxx
LEAGUE_ID=13
SEASON_YEAR=2026
